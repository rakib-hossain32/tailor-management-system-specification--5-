# npm run setup creates .env.local with a random AUTH_SECRET.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
AUTH_SECRET=replace-with-at-least-32-random-characters
LOCAL_DEMO_MODE=false
LOCAL_DB_PORT=5432

# Server-side Cloudinary credentials used to upload public site images.
CLOUDINARY_CLOUD_NAME=YOUR_CLOUDINARY_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=YOUR_CLOUDINARY_API_SECRET

# Optional HTTP SMS provider: POST { to, message, code, expires_in_seconds }
# with a Bearer token.
# Required for real customer OTP delivery when demo mode is disabled.
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
